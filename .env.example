# Letterprove
#
# Everything here is optional in development. With no signing key configured the
# service derives a deterministic key from a published seed, labels it
# `dev-insecure-…`, and says so on every page and in the discovery document.

# Base64 32-byte Ed25519 seed. Mint one with `npm run keygen`.
# PRODUCTION: this belongs to the SIGNER (Letterstory), not to this service —
# see the "signing seam" section of the README. It is here so the publishing
# half can run standalone before that seam is wired.
LETTERPROVE_SIGNING_KEY=

# Overrides the key id derived from the key material. Rarely needed.
LETTERPROVE_KEY_ID=

# Public JWKs of retired keys, as a JSON array. Keys stay here FOREVER after
# rotation — dropping one invalidates every proof it ever signed.
LETTERPROVE_RETIRED_JWKS=

# The countersign RPC (see "signing seam" below). Both required together —
# with either unset, countersign() falls back to signing locally with the
# dev key instead of calling out. The secret is a shared value with
# Letterstory's LETTERBRACE_LETTERPROVE_COUNTERSIGN_SECRET — same string,
# different env var name on each side.
LETTERSTORY_COUNTERSIGN_URL=
LETTERSTORY_COUNTERSIGN_SECRET=

# The active real signing key's PUBLIC half, as one JWK JSON object — set
# once Letterstory has minted the real key, so this service's JWKS endpoint
# serves the key that RPC signatures actually verify against instead of the
# locally-derived dev key. This service never holds the matching private key.
LETTERPROVE_PRODUCTION_JWK=

# Commit the `method` links point at. Vercel sets VERCEL_GIT_COMMIT_SHA and it
# is used automatically; set this only when building outside Vercel.
LETTERPROVE_COMMIT=

# Hot-tier storage (POST /v1/observe writes here). Without these, observations
# are validated and accepted (still 204) but not persisted — collection never
# fails closed on a missing datastore.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authenticates Vercel Cron's calls to GET /api/cron/rollup — Vercel sets
# Authorization: Bearer $CRON_SECRET automatically when this is configured on
# the project. Without it the route fails closed (401), it never runs open.
CRON_SECRET=
