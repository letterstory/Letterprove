# Letterprove
#
# Everything here is optional in development. With no signing key configured the
# service derives a deterministic key from a published seed, labels it
# `dev-insecure-…`, and says so on every page and in the discovery document.

# Base64 32-byte Ed25519 seed. Mint one with `npm run keygen`.
# PRODUCTION: this belongs to the SIGNER (Letterstory), not to this service —
# see the "signing seam" section of the README. It is here so the publishing
# half can run standalone before that seam is wired.
LETTERPROVE_SIGNING_KEY=

# Overrides the key id derived from the key material. Rarely needed.
LETTERPROVE_KEY_ID=

# Public JWKs of retired keys, as a JSON array. Keys stay here FOREVER after
# rotation — dropping one invalidates every proof it ever signed.
LETTERPROVE_RETIRED_JWKS=

# The countersign RPC (see "signing seam" below). Both required together —
# with either unset, countersign() falls back to signing locally with the
# dev key instead of calling out. The secret is a shared value with
# Letterstory's LETTERBRACE_LETTERPROVE_COUNTERSIGN_SECRET — same string,
# different env var name on each side.
LETTERSTORY_COUNTERSIGN_URL=
LETTERSTORY_COUNTERSIGN_SECRET=

# Authenticates Letterstory's BACKEND when it calls this service's vendor API
# (the Proofs surface inside Letterstory). Letterstory authorizes the user's org
# membership on its own side before calling, so this seam trusts the org_id it is
# handed — this secret is the whole proof the caller is Letterstory and not the
# public internet. Shared value, different env-var name on each side. Like
# CRON_SECRET, it fails CLOSED: unset means every such call is rejected (401),
# never admitted open. Mint one with `openssl rand -hex 32`.
LETTERSTORY_API_SECRET=

# The active real signing key's PUBLIC half, as one JWK JSON object — set
# once Letterstory has minted the real key, so this service's JWKS endpoint
# serves the key that RPC signatures actually verify against instead of the
# locally-derived dev key. This service never holds the matching private key.
LETTERPROVE_PRODUCTION_JWK=

# Commit the `method` links point at. Vercel sets VERCEL_GIT_COMMIT_SHA and it
# is used automatically; set this only when building outside Vercel.
LETTERPROVE_COMMIT=

# Hot-tier storage (POST /v1/observe writes here). Without these, observations
# are validated and accepted (still 204) but not persisted — collection never
# fails closed on a missing datastore.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authenticates Vercel Cron's calls to GET /api/cron/rollup — Vercel sets
# Authorization: Bearer $CRON_SECRET automatically when this is configured on
# the project. Without it the route fails closed (401), it never runs open.
CRON_SECRET=

# WHO IS STAFF. Comma-separated LETTERSTORY auth user ids (not emails) —
# Letterprove has no user pool of its own (see src/lib/staff/allowlist.ts).
# Letterstory forwards the acting human's user id on every tool-dispatcher
# call; a match here grants staff:read/staff:write, which expose every
# vendor's withheld customer domains and can create customer records for any
# vendor.
#
# Ids, not emails: this app has no way to verify address ownership for an
# identity it doesn't hold.
#
# Unset means NOBODY is staff — the staff capabilities exist but nothing
# grants them. Failing closed is the only safe default for this surface.
#
# Find an id: Letterstory's `select id, email from auth.users;`.
STAFF_USER_IDS=

# AES-256-GCM key for vendor Stripe credentials (src/lib/stripe/credentials.ts).
# Mint one with `openssl rand -base64 32`. Fails CLOSED: with this unset the
# service REFUSES to store a Stripe key rather than writing it in plaintext.
LETTERPROVE_STRIPE_ENCRYPTION_KEY=

# Slack incoming webhook for collector-health alerts. Unset disables alerting.
ALERT_WEBHOOK_URL=

# Slack incoming webhook for vendor support requests. Unset disables delivery.
SUPPORT_SLACK_WEBHOOK_URL=

# Resend API key, for sending tier-4 consent requests to customers
# (src/lib/email/consent.ts). Same Resend account letterbrace uses, and
# letterprove.com is already a verified sending domain there.
#
# Fails CLOSED, unlike the two webhooks above: with this unset a vendor cannot
# request consent at all. That is deliberate. The email IS the binding — it is
# what puts the approval link in the customer's hands rather than the vendor's
# — so "couldn't send" has to mean "no link exists", never "here, you deliver
# it". Skipping delivery silently would hand the vendor back the ability to
# countersign their own attestation.
RESEND_API_KEY=

# Optional. Overrides the From on those consent emails. Must be an address on
# a domain verified in the Resend account above.
# LETTERPROVE_EMAIL_FROM="Letterprove <staff@letterprove.com>"
